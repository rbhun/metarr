# Metarr settings for Docker. Copy to /opt/metarr/.env (deploy.sh does this on first run).

# Dedicated media user. Do not use 1000: on the NFS server it maps to a restricted account.
METARR_UID=1500
# Group "media". Write access to /mnt/media comes from this group.
METARR_GID=1002
# New files are group-writable so Radarr and Sonarr can manage them.
UMASK=002

# 1 = remux and file tagging only report what they would change. Nothing is written to /mnt/media.
METARR_DRY_RUN=0

# Work folder for remux and MP4 retagging. A Blu-ray remux needs up to ~50 GB here.
# Keep it outside Movies/, TV/ and the other library folders so Plex and the *arr apps never scan it.
# On the same share as the library, finished files are renamed into place instead of copied again.
METARR_SCRATCH=/mnt/media/.metarr-work

# Plex (http://192.168.30.5:32400 + X-Plex-Token), Radarr (http://192.168.30.4:7878) and
# Sonarr (http://192.168.30.4:8989) are set in Metarr under Settings, on their own cards.
