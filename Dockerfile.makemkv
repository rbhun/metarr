# Built only when vendor/makemkv is missing or holds another version. The app
# image copies those binaries and does not pull this Debian base on later deploys.
FROM debian:bookworm-slim
# 2.0.0 crashes (SIGSEGV) on every unencrypted Blu-ray image or folder right
# after "AACS directory not present"; 1.18.4 reads the same discs.
# 1.18.4 is no longer on the current download page. It stays under old/.
# makemkv.com currently ends the binary archive after 17 KB and still returns
# HTTP 200, so tar dies with "unexpected end of file". Take a full copy from
# the Internet Archive and require MakeMKV's published SHA-256.
# Compile one file at a time. make -j$(nproc) is killed when the machine has
# more cores than memory, and the build then stops with no compiler error.
ARG MAKEMKV_VERSION=1.18.4
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential pkg-config ca-certificates curl \
    libc6-dev libssl-dev libexpat1-dev libavcodec-dev zlib1g-dev \
  && mkdir /build && cd /build \
  && fetch() { \
       file="$1"; expected="$2"; shift 2; \
       for url in "$@"; do \
         echo "Fetching ${file}"; \
         rm -f "$file"; \
         curl --http1.1 --compressed -fL --retry 3 --retry-all-errors --retry-delay 2 \
           --connect-timeout 20 --max-time 300 -o "$file" "$url" || continue; \
         echo "${expected}  ${file}" | sha256sum -c - && return 0; \
         echo "Rejected ${file}: checksum did not match."; \
       done; \
       echo "Could not download a complete ${file}." >&2; \
       return 1; \
     } \
  && fetch "makemkv-oss-${MAKEMKV_VERSION}.tar.gz" \
       "8590063648d42ec2a958b74573d7022f0f4c334e4e4fe7dd53b70c6e748ba453" \
       "https://web.archive.org/web/20260711012600id_/https://www.makemkv.com/download/makemkv-oss-${MAKEMKV_VERSION}.tar.gz" \
       "https://www.makemkv.com/download/old/makemkv-oss-${MAKEMKV_VERSION}.tar.gz" \
  && fetch "makemkv-bin-${MAKEMKV_VERSION}.tar.gz" \
       "cee56de0baa5531abed16bd862742d308d772b4ab4dae16ee865bf74f04a1608" \
       "https://web.archive.org/web/20260718193213id_/https://www.makemkv.com/download/makemkv-bin-${MAKEMKV_VERSION}.tar.gz" \
       "https://web.archive.org/web/20260711012600id_/https://www.makemkv.com/download/makemkv-bin-${MAKEMKV_VERSION}.tar.gz" \
       "https://www.makemkv.com/download/old/makemkv-bin-${MAKEMKV_VERSION}.tar.gz" \
  && tar xzf "makemkv-oss-${MAKEMKV_VERSION}.tar.gz" \
  && tar xzf "makemkv-bin-${MAKEMKV_VERSION}.tar.gz" \
  && cd "makemkv-oss-${MAKEMKV_VERSION}" \
  && ./configure --disable-gui \
  && make -j1 \
  && make install \
  && cd "../makemkv-bin-${MAKEMKV_VERSION}" \
  && mkdir -p tmp && echo accepted > tmp/eula_accepted \
  && make \
  && make install \
  && rm -rf /build /var/lib/apt/lists/*
